# =====================================
# Terraform
# =====================================
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
*.tfplan.*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform variable files containing secrets
**/terraform.tfvars
**/terraform.tfvars.json
**/*.auto.tfvars
**/*.auto.tfvars.json

# Keep example variable files
!**/terraform.tfvars.example
!**/*.auto.tfvars.example

# =====================================
# Environment variables and secrets
# =====================================
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/

# =====================================
# SSH and AWS credentials
# =====================================
**/id_rsa
**/id_ed25519
**/aws_credentials
**/credentials.json

# =====================================
# Python
# =====================================
__pycache__/
*.py[cod]
*.pyo
venv/
.venv/
env/
ENV/
.pytest_cache/
.mypy_cache/

# =====================================
# Node.js
# =====================================
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# =====================================
# Build outputs
# =====================================
dist/
build/
target/
out/

# =====================================
# IDE and editor files
# =====================================
.vscode/
.idea/
*.swp
*.swo
*~

# =====================================
# Operating system files
# =====================================
.DS_Store
Thumbs.db
desktop.ini

# =====================================
# Logs and temporary files
# =====================================
*.log
*.tmp
*.bak
*.old

# =====================================
# Cloud credentials and private keys
# =====================================
*.secret
*.token
