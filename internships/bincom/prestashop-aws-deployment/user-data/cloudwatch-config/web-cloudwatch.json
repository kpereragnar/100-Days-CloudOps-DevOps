{
  "agent": {
    "metrics_collection_interval": 60,
    "run_as_user": "root"
  },
  "metrics": {
    "namespace": "PrestaShop/Infrastructure",
    "append_dimensions": {
      "InstanceId": "${aws:InstanceId}"
    },
    "metrics_collected": {
      "mem": {
        "measurement": [
          "mem_used_percent"
        ],
        "metrics_collection_interval": 60
      },
      "disk": {
        "measurement": [
          "used_percent"
        ],
        "resources": [
          "/"
        ],
        "metrics_collection_interval": 60
      }
    }
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/apache2/access.log",
            "log_group_name": "/prestashop/web-server",
            "log_stream_name": "{instance_id}/apache-access"
          },
          {
            "file_path": "/var/log/apache2/error.log",
            "log_group_name": "/prestashop/web-server",
            "log_stream_name": "{instance_id}/apache-error"
          }
        ]
      }
    }
  }
}
